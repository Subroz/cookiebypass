# Required in production
API_KEY=replace-with-a-long-random-api-key
ADMIN_KEY=replace-with-a-separate-admin-key

# Cookie files are mounted as /run/secrets/cookies/<platform>.txt
COOKIE_DIR=/run/secrets/cookies
ALLOWED_ORIGINS=*
REQUEST_TIMEOUT_SECONDS=90
MAX_CONCURRENT_JOBS=2
MAX_FORMATS=40

# Optional outbound proxy for authorized extraction traffic
EXTRACTOR_PROXY=socks5h://username:password@proxy-host:port
